#define TORABO_TSUKI_LP_RIGHT 1
#define TORABO_TSUKI_LP_MATRIX_COL_OFFSET 7

#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&pointing_listener {
    /* 通常時（オートマウス）：座標反転 ＋ 自動的に Layer 5（10秒保持）へ一時切り替え */
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 3 4>, /* ★ マウス感度: 0.5倍（半分） */
        <&zip_temp_layer 5 5000>;

    /* Pキー長押し（Layer 6）：トラックボール移動をスクロールに変換 */
    scroll {
        layers = <6>;
        input-processors = 
        <&zip_xy_to_scroll_mapper>,
        <&zip_scroll_scaler 3 4>; /* ★ スクロール感度: 0.5倍（半分） */
    };
};

&size_s_transform { col-offset = <7>; };
&size_m_transform { col-offset = <7>; };
&size_l_transform { col-offset = <7>; };

/* オートマウス起動中でもレイヤーが自動解除されないキー位置（クリックキー等） */
&zip_temp_layer {
    excluded-positions = <19 33 34 35 47>;
};
